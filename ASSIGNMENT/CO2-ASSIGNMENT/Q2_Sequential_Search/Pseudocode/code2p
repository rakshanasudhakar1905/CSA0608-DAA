# Q2: Sequential Search
## 1. Algorithm: Sequential Search
ALGORITHM SequentialSearch(data, target)
    comparisons ← 0
    START TIMER
    FOR index ← 0 TO LENGTH(data) - 1
        comparisons ← comparisons + 1
        IF data[index] = target THEN
            STOP TIMER
            elapsed ← execution time
            RETURN index, comparisons, elapsed
        END IF
    END FOR
    STOP TIMER
    elapsed ← execution time
    RETURN -1, comparisons, elapsed
END ALGORITHM
