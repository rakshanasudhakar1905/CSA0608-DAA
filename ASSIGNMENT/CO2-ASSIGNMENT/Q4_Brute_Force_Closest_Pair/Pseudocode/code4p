# Q4: Brute-Force Closest Pair of Points
## 1. Algorithm: Find the Closest Pair
ALGORITHM ClosestPair(points)
    n ← LENGTH(points)
    IF n < 2 THEN
        RETURN no pair
    END IF
    min_distance ← INFINITY
    closest_points ← NONE
    pairs_examined ← 0
    distance_calculations ← 0
    START TIMER
    FOR i ← 0 TO n - 1
        FOR j ← i + 1 TO n - 1
            pairs_examined ← pairs_examined + 1
            x1 ← points[i].x
            y1 ← points[i].y
            x2 ← points[j].x
            y2 ← points[j].y
            distance_calculations ← distance_calculations + 1
            distance ← SQRT(
                (x2 - x1)² + (y2 - y1)²
            )
            IF distance < min_distance THEN
                min_distance ← distance
                closest_points ← (points[i], points[j])
            END IF
        END FOR
    END FOR
    STOP TIMER
    RETURN closest_points,
           min_distance,
           pairs_examined,
           distance_calculations,
           execution time
END ALGORITHM
## 2. Algorithm: Performance Testing
ALGORITHM Main
    SET random seed to 42
    sizes ← [5, 10, 20, 50, 100]
    FOR EACH size IN sizes
        GENERATE size random two-dimensional points
        CALL ClosestPair(points)
        expected_pairs ← size × (size - 1) / 2
        DISPLAY number of points
        DISPLAY closest pair
        DISPLAY minimum distance
        DISPLAY pairs examined
        DISPLAY expected number of pairs
        DISPLAY distance calculations
        DISPLAY execution time
    END FOR
END ALGORITHM